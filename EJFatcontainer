# syntax=docker/dockerfile:1

# Stage 1: Base Ubuntu 24 with E2SAR

FROM ubuntu:24.04 AS base
ENV DISTRO=ubuntu24
ENV HOME=/home/ubuntu
ENV LD_LIBRARY_PATH=/usr/local/lib
ENV PATH=/usr/local/bin:$PATH
ENV DEPSVER=0.3.0
ENV DEPSDEB=e2sar-deps_${DEPSVER}_amd64.deb

RUN apt-get -yq update && apt-get -yq install --no-install-recommends \
    python3-pip build-essential autoconf cmake libtool pkg-config \
    libglib2.0-dev ninja-build openssl libssl-dev libsystemd-dev \
    protobuf-compiler libre2-dev gdb curl git vim zip unzip tar ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --break-system-packages pybind11 scapy meson

RUN apt-get update && apt-get install -y git-lfs && git lfs install 

# Stage 2: Install E2SAR dependencies

FROM base AS compile-e2sar
WORKDIR /src
COPY ./docker-dev-entrypoint.sh /src/docker-dev-entrypoint.sh
RUN curl -Ls https://github.com/JeffersonLab/E2SAR/releases/download/E2SAR-main-$DEPSVER-ubuntu-24.04/$DEPSDEB > $DEPSDEB  
RUN dpkg -i $DEPSDEB
ENTRYPOINT ["/src/docker-dev-entrypoint.sh"]
CMD ["setup_src"]


# Stage 3: Build fastcache using vcpkg

FROM compile-e2sar AS builder
RUN git clone --filter=blob:none https://github.com/microsoft/vcpkg /opt/vcpkg \
    && /opt/vcpkg/bootstrap-vcpkg.sh -disableMetrics
ENV VCPKG_ROOT=/opt/vcpkg
WORKDIR /build
COPY . .

RUN --mount=type=cache,target=/root/.cache/vcpkg \
    VCPKG_BINARY_SOURCES="clear;files,/root/.cache/vcpkg,readwrite" \
    cmake --preset default \
    && cmake --build build --preset default


# Stage 4: Final step

FROM ubuntu:24.04 AS runtime
COPY --from=builder /build/build/lclstream-fastcache /usr/local/bin/lclstream-fastcache
# Custom config from current dir
COPY config.json /etc/lclstream/config.json

CMD ["lclstream-fastcache"]
